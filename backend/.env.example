# Enterprise GTM Intelligence Agent — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── Gemini API ──────────────────────────────────────────────────────────────
# Get your free API key at: https://aistudio.google.com/
GEMINI_API_KEY=API_KEY_GOES_HERE
# Gemini model — use a model available on your free tier
# Check available models: https://ai.google.dev/gemini-api/docs/models/gemini
GEMINI_MODEL=gemini-3.8-flash

# ─── Application ─────────────────────────────────────────────────────────────
APP_NAME=Enterprise GTM Intelligence Agent
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=development

# ─── Database (SQLite local file by default, no Docker required) ─────────────
DATABASE_URL=sqlite+aiosqlite:///./gtm_intelligence.db
DATABASE_ECHO=false

# ─── ChromaDB ────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION_NAME=gtm_documents

# ─── Embeddings ──────────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ─── RAG ─────────────────────────────────────────────────────────────────────
RAG_TOP_K=8
RAG_SIMILARITY_THRESHOLD=0.35

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ─── Scoring ─────────────────────────────────────────────────────────────────
SCORE_HIGH_THRESHOLD=80
SCORE_MEDIUM_THRESHOLD=60
